# CI-safe defaults — no secrets, no API keys
# This file is copied to config/.env by the CI workflow.
# It is safe to commit because it contains no real credentials.

PORT=8000
LOG_LEVEL=WARNING

# Data directory — tests use in-memory SQLite, but config.py needs a valid path
DATA_DIR=./data

# Application settings (no API keys — LLM tests are skipped in CI)
# SCRAPER_STEALTH_LEVEL=balanced