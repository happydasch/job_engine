# Data directory (default: <project-root>/data — override only if needed)
#DATA_DIR=data


# Dashboard
PORT=8000
LOG_LEVEL=INFO

# Proxy (optional)
# HTTP_PROXY=http://user:pass@host:port
# HTTPS_PROXY=https://user:pass@host:port
# Scraper stealth level (browser-based scrapers)
#   "minimal"  — basic UA + viewport only (fastest)
#   "balanced" — full stealth suite (default)
#   "paranoid" — canvas, WebGL, font enumeration, WebRTC blocking, extra delays
# SCRAPER_STEALTH_LEVEL=balanced

# Proxy health check settings
# PROXY_HEALTH_CHECK_URL=http://ip-api.com/json
# PROXY_HEALTH_CHECK_TIMEOUT=5000

